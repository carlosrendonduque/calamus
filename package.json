{
  "name": "calamus",
  "version": "0.1.0",
  "description": "Reusable React reader component for narrative prose.",
  "keywords": [
    "react",
    "react-component",
    "reader",
    "reading-mode",
    "narrative",
    "interactive-narrative",
    "digital-narrative",
    "electronic-literature",
    "hypertext",
    "prose",
    "typography",
    "pagination",
    "longform",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/carlosrendonduque/calamus#readme",
  "bugs": {
    "url": "https://github.com/carlosrendonduque/calamus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosrendonduque/calamus.git"
  },
  "license": "MIT",
  "author": {
    "name": "Carlos Rendon",
    "email": "carlos.rendon.duque@gmail.com",
    "url": "https://github.com/carlosrendonduque"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "prepare": "npm run build",
    "build": "tsup && tsc -p tsconfig.build.json --noEmit",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^2.1.9"
  }
}
